# ─── LLM Providers ───────────────────────────────────────────────────────────
# Comma-separated OpenAI-compatible API keys (Groq, Cerebras, OpenAI, etc.)
OPENAI_API_KEYS=your_key_1,your_key_2
OPENAI_BASE_URL=https://api.groq.com
OPENAI_MODEL=llama-3.3-70b-versatile

# Ollama local fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Gemini
GEMINI_API_KEYS=your_gemini_key

# ─── Memory ──────────────────────────────────────────────────────────────────
MEM0_API_KEY=

# ─── Telegram Notifications ──────────────────────────────────────────────────
# Keep this file private: chmod 600 .env
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Session ─────────────────────────────────────────────────────────────────
DEFAULT_SESSION=nova_default

# ─── Safety ──────────────────────────────────────────────────────────────────
RISK_CONFIRM_THRESHOLD=7

# ─── Token Usage / Limits ────────────────────────────────────────────────────
DAILY_TOKEN_ALERT_THRESHOLD=50000
# Hard cap — set to 0 to disable. When reached, all LLM calls are blocked for the day.
DAILY_TOKEN_HARD_CAP=0

# ─── ADB ─────────────────────────────────────────────────────────────────────
ADB_PORT=5555

# ─── OmniParser Vision ───────────────────────────────────────────────────────
OMNIPARSER_SERVER_URL=http://localhost:8000
OMNIPARSER_REPO_DIR=./OmniParser

# ─── Proactive Screen Watcher ────────────────────────────────────────────────
PROACTIVE_WATCHER_ENABLED=false
# Increase interval to reduce GPU pressure: recommend 30+ seconds
PROACTIVE_WATCHER_INTERVAL=30
PROACTIVE_WATCHER_COOLDOWN=120

# ─── Phone Watcher ───────────────────────────────────────────────────────────
PHONE_WATCHER_ENABLED=false

# ─── Autonomy ────────────────────────────────────────────────────────────────
AUTONOMY_ENABLED=false
AUTONOMY_POLL_SECONDS=5
AUTONOMY_MAX_STEPS=20
AUTONOMY_NOTIFY_TELEGRAM=false
AUTONOMY_NOTIFY_TTS=false

# ─── Voice / Wake Word ───────────────────────────────────────────────────────
VOICE_BARGEIN_ENABLED=false
VOICE_BARGEIN_HOTKEY=ctrl+shift+space
# Download .ppn from https://console.picovoice.ai/ — place in ./assets/
PORCUPINE_ACCESS_KEY=
PORCUPINE_KEYWORD_PATH=./assets/Hey-Nova_en_windows_v3_0_0.ppn

# ─── Context ─────────────────────────────────────────────────────────────────
INCLUDE_CLIPBOARD_IN_CONTEXT=false
