__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
.env

# ChromaDB vector stores — may grow unboundedly on disk
.jarvis_chroma/
.jarvis_docs/

# APScheduler job database
jarvis_jobs.sqlite

# Persisted session history (contains conversation content) (fix 2.6)
.jarvis_sessions/

# Emergency stop persistence file (fix 1.9)
.jarvis/

# Logs — may contain sensitive action audit trails (Security 4.1)
logs/*
!logs/.gitkeep
*.jsonl

# Session exports — contain full conversation history (Security 4.1)
exports/*
!exports/.gitkeep

# OmniParser vendor checkout — handled as submodule or download
vendor/

# Ruff/mypy/pytest caches
.ruff_cache/
.mypy_cache/
.qoder/

# macOS metadata
.DS_Store

# Editor tempfiles
*.swp
*.swo
.jarvis/
BUG.TXT
BUG.TXT
