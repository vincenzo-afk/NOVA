__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
.env

# ChromaDB vector stores — may grow unboundedly on disk
.jarvis_chroma/
.jarvis_docs/

# APScheduler job database
*.sqlite

# Persisted session history (contains conversation content)
.jarvis_sessions/

# Emergency stop persistence file
.jarvis/

# Logs — may contain sensitive action audit trails
logs/
*.jsonl

# Session exports — contain full conversation history
exports/

# OmniParser vendor checkout — handled as submodule or download
vendor/

# Ruff/mypy/pytest caches
.ruff_cache/
.mypy_cache/
.qoder/

# macOS metadata
.DS_Store

# Editor tempfiles
*.swp
*.swo
